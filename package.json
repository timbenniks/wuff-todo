{
  "name": "wuff-todo",
  "private": true,
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm build:mcp && pnpm --filter @wuff/web dev",
    "build": "pnpm build:mcp && pnpm --filter @wuff/web build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit",
    "test": "node --import tsx --test tests/contracts.test.ts tests/oauth-policy.test.ts tests/list-cache.test.ts tests/session-result.test.ts tests/page-session.test.ts tests/live-refresh.test.ts tests/task-content.test.ts tests/editor-ordering.test.ts tests/task-images.test.ts tests/due-dates.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "build:mcp": "node scripts/build-mcp.mjs",
    "test:integration": "node --env-file=.env.local --import tsx --test --test-concurrency=1 tests/*.integration.test.ts",
    "format": "prettier --write . --ignore-path .gitignore",
    "format:check": "prettier --check . --ignore-path .gitignore"
  },
  "devDependencies": {
    "@neon/realtime": "0.1.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "8.18.2",
    "@wuff/contracts": "workspace:*",
    "@wuff/db": "workspace:*",
    "@wuff/domain": "workspace:*",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.28.2",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "ws": "8.21.2"
  },
  "type": "module"
}
