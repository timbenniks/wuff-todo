{
  "identifier": "local-backend",
  "description": "Explicit development build only, isolated localhost backend.",
  "windows": [
    "main"
  ],
  "permissions": [
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "http://localhost:3000/oauth/authorize*"
        },
        {
          "url": "http://localhost:3000/*"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://localhost:3000/api/mobile"
        },
        {
          "url": "http://localhost:3000/oauth/tauri"
        },
        {
          "url": "http://localhost:3000/oauth/token"
        },
        {
          "url": "http://localhost:3000/oauth/revoke"
        },
        {
          "url": "http://localhost:3000/api/mobile/images*"
        }
      ]
    }
  ]
}
