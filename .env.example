# Obtain environment-specific values through the Vercel integration.
# Local development must use the isolated development branch; see docs/development.md.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
WUFF_ORIGIN=http://localhost:3000

# Optional live updates; keep the secret server-only. Both values must target
# the same Neon branch as DATABASE_URL. No NEXT_PUBLIC_ secret is needed.
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=

# Private task images: separate development/production Blob stores.
# Both secrets stay server-only; never use NEXT_PUBLIC_ prefixes.
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=

# GitHub App sync: server-only, separate credentials for development/production.
GITHUB_APP_ID=5355720
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN_SECRET=

# Cursor cloud agents: independent server-side encryption key (32+ random chars).
# Leave paid execution disabled until account/environment validation is complete.
# Independent random encryption key for personal Cursor connections in Neon.
CURSOR_TOKEN_SECRET=
CURSOR_EXECUTION_ENABLED=false

# Personal reminders: QStash delayed callbacks (server-only). No minute cron.
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# VAPID public key is intentionally returned to the subscribing browser.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
# Apple .p8 signing key, base64 encoded. Topics must match signed app identities.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY_BASE64=
APNS_IOS_TOPIC=
APNS_MACOS_TOPIC=
APNS_SANDBOX=false
# Firebase service account JSON, base64 encoded; never ship in the Android app.
FCM_SERVICE_ACCOUNT_BASE64=
# WNS app credentials matching the packaged Windows app/channel registration.
WNS_CLIENT_ID=
WNS_CLIENT_SECRET=
