{
  "name": "wuff-todo",
  "private": true,
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm build:guide && pnpm build:mcp && pnpm --filter @wuff/web dev",
    "preview:local": "pnpm build && pnpm --filter @wuff/web start",
    "build": "pnpm build:guide && pnpm build:mcp && pnpm --filter @wuff/web build",
    "typecheck": "pnpm -r typecheck && tsc --noEmit",
    "test": "node scripts/test-unit.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "build:mcp": "node scripts/build-mcp.mjs",
    "test:integration": "node --env-file=.env.local --import tsx --test --test-concurrency=1 tests/*.integration.test.ts",
    "format": "prettier --write . --ignore-path .gitignore",
    "format:check": "prettier --check . --ignore-path .gitignore",
    "build:guide": "node scripts/build-guide.mjs"
  },
  "devDependencies": {
    "@neon/realtime": "0.1.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/ws": "8.18.2",
    "@wuff/contracts": "workspace:*",
    "@wuff/db": "workspace:*",
    "@wuff/domain": "workspace:*",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.28.2",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "ws": "8.21.2",
    "@tiptap/markdown": "3.32.0"
  },
  "type": "module"
}
